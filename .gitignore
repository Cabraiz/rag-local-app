# Private local credentials and transient artifacts; never version these.
.local/
**/.local/
**/.env
**/.env.*
!**/.env.example
**/__pycache__/
**/.venv/
app/semantic/model/
eval/logs/
tmp/
cache/

# Runtime records, browser proofs and deliverables stay private even in a private repo.
eval/runs/
eval/history/
eval/receipts/
eval/resilience-runtime/
deliveries/
docs/architecture/proof/
docs/history/architecture-checks/
carrefour-challenge/evidence/
**/node_modules/
**/.pytest_cache/
**/.cache/
**/generated/
**/*.sqlite3*
**/*.db
**/*.log
**/*.pyc
**/*.pyo
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*.json
**/*service-account*.json
**/*client_secret*.json
**/dist/
**/build/
