# Copie para .env (nunca versione o .env).
# GOOGLE_API_KEY vai só para os serviços agent e tests-e2e; o Compose lê API_PORT para publicar a API.
GOOGLE_API_KEY=
# Chave opcional que cifra as listas de exames gravadas pela API; só o serviço api a recebe.
# Vazia: a api gera uma na 1ª subida e a guarda num volume próprio (api-key), separado do banco (api-data).
# `docker compose down -v` apaga a chave junto com o banco; uma cópia antiga do banco fica ilegível.
# Para usar a sua: docker compose run --rm --no-deps api python -m api.crypto --gerar-chave
DB_ENCRYPTION_KEY=
# Porta do host para a API (Swagger em http://127.0.0.1:${API_PORT}/docs).
API_PORT=8765
# Hosts que os servidores de uma spec podem usar ("host" para qualquer porta, "host:porta" para uma).
# Vazio: ocr:8001,rag:8002,api:8000 (os serviços do compose, cada um na sua porta). Só o serviço agent recebe.
ALLOWED_HOSTS=
# Requisições por minuto por IP de cliente na API; acima disso, 429 com Retry-After. Vazio: 1200; 0 desliga.
API_RATE_LIMIT_PER_MINUTE=
# Nomes que a API aceita no cabeçalho Host, em qualquer porta (contra DNS rebinding). Vazio: 127.0.0.1,localhost,api.
API_ALLOWED_HOSTS=
# Horas que a API lembra uma Idempotency-Key (guardada só como HMAC). Vazio: 24.
API_IDEMPOTENCY_TTL_HOURS=
# Opcional: outro modelo Gemini para o agent, no lugar do da spec (vazio: o da spec).
# GEMINI_MODEL=gemini-3.5-flash-lite
# O código lê também DB_PATH, DB_KEY_FILE, EXAMS_PATH, SAMPLES_DIR, OMP_THREAD_LIMIT e CI,
# que já têm o valor certo dentro dos containers e não vêm daqui (ver "Variáveis de ambiente" em docs/como-rodar.md).
