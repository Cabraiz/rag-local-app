FROM rag-local-backend:0.1.0
USER root
COPY infrastructure/dependencies/backend/resilience-requirements.lock /tmp/resilience-requirements.lock
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/resilience-requirements.lock && pip check
COPY --chown=10001:10001 src /app/src
USER 10001:10001
