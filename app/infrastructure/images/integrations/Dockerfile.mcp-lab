FROM rag-local-backend:0.1.0
USER root
COPY infrastructure/dependencies/integrations/mcp-requirements.lock /tmp/mcp-requirements.lock
RUN pip install --no-cache-dir --only-binary=:all: --no-deps --require-hashes -r /tmp/mcp-requirements.lock && pip check
COPY --chown=10001:10001 src/rag_app/integrations/atlassian_lab.py /app/src/rag_app/integrations/atlassian_lab.py
USER 10001:10001
CMD ["python", "-m", "rag_app.atlassian_lab"]
