        ],
        "title": "ValidationFailure"
      },
      "ValidationIssue": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "type"
        ],
        "title": "ValidationIssue"
      }
    }
  }
}