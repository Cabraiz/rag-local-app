          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "InvalidEnvelope"
      },
      "JSONRequired": {
        "properties": {
          "code": {
            "type": "string",
            "const": "JSON_REQUIRED",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "JSONRequired"
      },
      "LedgerError": {
        "properties": {
          "detail": {
            "type": "string",
            "const": "LEDGER_UNAVAILABLE_RETRY_SAME_KEY",
